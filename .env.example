# Copy to .env and fill with values from your own backend project.
# NEVER commit real keys. All values below are placeholders.

# --- Client-visible (Vite) ---
VITE_SUPABASE_URL="https://<project-ref>.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="<publishable-or-anon-key>"
VITE_SUPABASE_PROJECT_ID="<project-ref>"

# --- Server-side (SSR / server functions) ---
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_PUBLISHABLE_KEY="<publishable-or-anon-key>"
SUPABASE_PROJECT_ID="<project-ref>"

# Server-only secrets (never exposed to the browser).
# Provided by the hosting platform / secret manager, not by this file in production.
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"   # required by /admin stats only
ADMIN_PASSWORD="<admin-dashboard-password>"      # required by /admin only
